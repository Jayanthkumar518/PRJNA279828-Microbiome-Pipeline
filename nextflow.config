params {

    reads      = "data/raw/*_{1,2}.fastq.gz"

    outdir     = "results"

    threads    = 8

    classifier = "reference/silva-138-99-nb-classifier.qza"

    metadata   = "metadata/metadata.tsv"
}

process {

    cpus = params.threads

    errorStrategy = 'terminate'

    publishDir = [
        path: params.outdir,
        mode: 'copy'
    ]
}

profiles {

    standard {

        process.executor = 'local'

    }

    conda {

        conda.enabled = true

    }

    docker {

        docker.enabled = true

    }

}